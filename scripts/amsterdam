#!/bin/sh
# amsterdam - run the Amsterdam Console with the host daemon (default),
# or as an opt-in Docker container.

SELF=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)
AMSTER="$SCRIPT_DIR/amster"
AMSTER_DOCKER="$SCRIPT_DIR/amster-docker"
PORT="${PORT:-3131}"

usage() {
    cat <<'EOF'
usage: amsterdam [command]

commands:
  (none)  Start the host daemon in the background, or open the live dashboard
  serve   Run the host daemon in the foreground (Ctrl+C to stop)
  start   Start the host daemon in the background (same as no arguments)
  status  Show whether the host daemon is running
  open    Open the dashboard in a browser
  demo    Open the dashboard with sample data and the onboarding tour
  docker  Run the dashboard as a background Docker container
  up      Same as docker
  stop    Stop the background Docker container
  run     Run Docker in the foreground (Ctrl+C to stop)
  build   Build the Docker image
  dump    Fetch billing data once
  link    Show the file:// URL of the launcher
  path    Show the absolute path of the launcher
  help    Show this help
EOF
}

case "${1:-}" in
    '')
        out="$("$AMSTER" start)"
        status=$?
        printf '%s\n' "$out"
        if [ "$status" -ne 0 ]; then
            exit "$status"
        fi
        case "$out" in
            *"already running"*)
                "${AMSTERDAM_OPEN:-xdg-open}" "http://localhost:$PORT"
                ;;
        esac
        ;;
    serve|daemon)
        exec "$AMSTER" serve
        ;;
    start|status|dump|fetch|open|demo|link|path)
        exec "$AMSTER" "$@"
        ;;
    docker|up)
        exec "$AMSTER_DOCKER" up
        ;;
    stop|build|run)
        exec "$AMSTER_DOCKER" "$1"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
