#!/bin/sh

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
HTML=/home/eve/Coding_Projects/amsterdam/index.html

if [ -f "$SCRIPT_DIR/../index.html" ]; then
    REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
    HTML="$REPO_DIR/index.html"
fi

usage() {
    cat <<'EOF'
usage: amster [command]

commands:
  link   Show the file:// URL of the launcher
  path   Show the absolute path of the launcher
  dump   Open the launcher (open the floodgates)
  open   Same as dump
  help   Show this help

Without arguments, shows this help and the file:// URL.
EOF
    printf 'URL: file://%s\n' "$HTML"
}

case "${1:-}" in
    '')
        usage
        ;;
    link)
        printf 'file://%s\n' "$HTML"
        ;;
    path)
        printf '%s\n' "$HTML"
        ;;
    dump|open)
        if [ ! -f "$HTML" ]; then
            echo "Error: file not found: $HTML" >&2
            exit 1
        fi
        xdg-open "$HTML"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
