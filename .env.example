# Amsterdam — environment variables
#
# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored: it must NEVER be committed or pushed.
# Real keys in the repo = rotate them immediately.

# DeepSeek — has a real balance endpoint
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Hugging Face — account info endpoint
HF_TOKEN=

# Providers that only verify the key against /v1/models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GOOGLE_API_KEY=
FIREWORKS_API_KEY=
