# Amsterdam — environment variables
# Generated from src/providers/catalog.js — run `node scripts/sync-providers` after edits.
# Copy this file to `.env` and fill in your keys.
# `.env` is git-ignored: it must NEVER be committed or pushed.
# Real keys in the repo = rotate them immediately.

# DeepSeek — balance API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot — balance API
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn

# Hugging Face — account info
HF_TOKEN=

# OpenAI — key verification
OPENAI_API_KEY=

# Google AI Studio — key verification
GOOGLE_API_KEY=

# Groq — key verification
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai

# Together — key verification
TOGETHER_API_KEY=

# Mistral — key verification
MISTRAL_API_KEY=

# Fireworks — key verification
FIREWORKS_API_KEY=

# xAI — key verification
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai

# Anthropic — key verification
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Z.AI / GLM — balance API
